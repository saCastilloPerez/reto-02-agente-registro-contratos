PORT=3000
MAX_ITERATIONS=25

# Valor por defecto: usa reglas locales PERXIA, sin costo ni credencial.
LLM_PROVIDER=perxia
LLM_MODEL=reglas-locales-v1

# Adaptador real reutilizado de ai_agent-supplier-register.
# Para activarlo: LLM_PROVIDER=opencode-go y definir la clave solo en .env.
OPENCODE_MODEL=minimax-m3
OPENCODE_API_KEY=
LLM_TIMEOUT_MS=30000

# Reservado para otros adaptadores externos. Nunca exponer al frontend ni versionar .env.
LLM_API_KEY=
